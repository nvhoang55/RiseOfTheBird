# Build output
# ---------------------------------------------------------------------------
target/
build/
dist/

# Maven Shade plugin byproduct (kept here in case shade is ever re-introduced).
dependency-reduced-pom.xml

# Maven local Wrapper distribution cache (when committed alongside the project).
.mvn/wrapper/dists/

