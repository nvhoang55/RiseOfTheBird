# IDEs & editors
# ---------------------------------------------------------------------------

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.factorypath
.apt_generated/
.apt_generated_test/

# VS Code
.vscode/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# JEnv
.java-version

