*~
.fuse_hidden*
.nfs*

# ---------------------------------------------------------------------------
# Java compile output (shouldn't appear with Maven, but guard anyway)
# ---------------------------------------------------------------------------
*.class

# Generic jars are noise; the Maven Wrapper jar is committed on purpose.
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Native image / hsperfdata
hs_err_pid*
replay_pid*
*.hprof

