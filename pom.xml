<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.riseofthebird</groupId>
    <artifactId>rise-of-the-bird</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Rise of the Bird</name>
    <description>
        An Angry Birds-style game built on Princeton's StdDraw, refactored for
        modern Java. Originally a midterm project for HUST's Introduction to
        Java course; now runs stand-alone via java -jar with no IDE.
    </description>
    <url>https://github.com/HiepNguyen-X/RiseOfTheBird</url>
    <inceptionYear>2018</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Rise of the Bird contributors</name>
            <url>https://github.com/HiepNguyen-X/RiseOfTheBird/graphs/contributors</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/HiepNguyen-X/RiseOfTheBird</url>
        <connection>scm:git:https://github.com/HiepNguyen-X/RiseOfTheBird.git</connection>
        <developerConnection>scm:git:git@github.com:HiepNguyen-X/RiseOfTheBird.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/HiepNguyen-X/RiseOfTheBird/issues</url>
    </issueManagement>

    <properties>
        <!-- Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Toolchain -->
        <maven.compiler.release>21</maven.compiler.release>
        <enforcer.maven.version>3.9.0</enforcer.maven.version>
        <enforcer.java.version>21</enforcer.java.version>

        <!-- Application entry point -->
        <main.class>com.riseofthebird.App</main.class>

        <!-- Plugin versions, grouped here for one-line bumps -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>

        <!-- Compile-time annotation processor versions -->
        <record-builder.version>52</record-builder.version>

        <!-- Test dependency versions -->
        <junit-jupiter.version>5.11.4</junit-jupiter.version>
    </properties>

    <dependencies>
        <!--
            RecordBuilder generates `with*` copy methods for annotated records
            so we don't have to hand-write them. The `core` artifact carries
            only the @RecordBuilder annotation and the marker `With` interface;
            the actual code generation lives in the `processor` artifact, which
            is configured below as an annotation-processor path on the compiler
            plugin (so it is NOT packaged into the runtime jar).

            Scope `provided` means the core jar (which contains the annotation
            and the With marker interface that our records implement) is on the
            compile classpath but is treated as supplied by the environment at
            runtime. The annotation is retained at SOURCE level only, so no
            classes from this dependency end up in the packaged jar.
        -->
        <dependency>
            <groupId>io.soabase.record-builder</groupId>
            <artifactId>record-builder-core</artifactId>
            <version>${record-builder.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            JUnit 5 (Jupiter) for unit tests against the pure logic layer.
            test scope only - never ships in the runtime jar.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            We deliberately do NOT redeclare <sourceDirectory>, <resources>,
            <testSourceDirectory>, <testResources>, or <finalName>: the Maven
            defaults already match the standard layout this project uses
            (src/main/java, src/main/resources, src/test/java, ${artifactId}-${version}).
            Redeclaring them would just be noise.
        -->

        <pluginManagement>
            <plugins>
                <!-- Lifecycle plugins: pin versions even though we don't reconfigure them. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>

                <!-- Plugins we actively configure below also get their versions pinned here. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Enforcer: fail fast on the wrong Maven or JDK rather than
                emitting a confusing compile error 30 seconds in.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${enforcer.maven.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${enforcer.java.version},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Compiler: pin to release 21 with strict warnings, and run the
                RecordBuilder annotation processor so every @RecordBuilder
                record gets its companion builder + With interface generated
                under target/generated-sources/annotations.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.soabase.record-builder</groupId>
                            <artifactId>record-builder-processor</artifactId>
                            <version>${record-builder.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                JAR: the project has zero runtime dependencies, so the plain
                project jar is already executable. We just need to declare the
                Main-Class in the manifest. No shade plugin needed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <addMavenDescriptor>true</addMavenDescriptor>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!--
                Exec: lets developers run the game from sources via
                `./mvnw compile exec:java` without packaging a jar first.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
